# ==========================================================================
# TIRDO Web Platform - environment
# Copy to `.env` before first run:  Copy-Item .env.example .env
# Rotate every secret before any non-local deployment.
# ==========================================================================

# Public base URL (nginx entrypoint). Use http://localhost for local Docker.
PUBLIC_URL=http://localhost
NODE_ENV=production

# --- PostgreSQL (Strapi + Keycloak) ---------------------------------------
POSTGRES_USER=tirdo
POSTGRES_PASSWORD=change_me_postgres
STRAPI_DB_NAME=tirdo_cms
KEYCLOAK_DB_NAME=tirdo_keycloak

# --- Strapi secrets (generate random base64 strings) ----------------------
STRAPI_APP_KEYS=key1aaaaaaaaaaaaaaaa,key2bbbbbbbbbbbbbbbb,key3cccccccccccccccc,key4dddddddddddddddd
STRAPI_API_TOKEN_SALT=change_me_api_token_salt
STRAPI_ADMIN_JWT_SECRET=change_me_admin_jwt
STRAPI_TRANSFER_TOKEN_SALT=change_me_transfer_salt
STRAPI_JWT_SECRET=change_me_jwt
STRAPI_ENCRYPTION_KEY=change_me_encryption_key

# --- Keycloak -------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_REALM=tirdo
KEYCLOAK_CLIENT_ID=tirdo-web

# --- MinIO (S3-compatible object storage) ---------------------------------
MINIO_ENDPOINT=minio
MINIO_ROOT_USER=tirdo-minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=tirdo-media

# --- OpenSearch -----------------------------------------------------------
OPENSEARCH_INDEX=tirdo-content

# --- Matomo (MariaDB) -----------------------------------------------------
MATOMO_DB_ROOT_PASSWORD=change_me_matomo_root
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=change_me_matomo
# Read-only Matomo auth token for the footer counter + /analytics dashboard.
# Create it in Matomo: top-right avatar -> Personal -> Security -> Auth tokens.
MATOMO_API_TOKEN=

# --- Email / SMTP ---------------------------------------------------------
# Local dev uses the Mailpit container (host "mailpit", port 1025, no auth).
# For production, point these at your real SMTP server and set credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@tirdo.or.tz
EMAIL_REPLY_TO=info@tirdo.or.tz
# Who receives contact-form notifications:
CONTACT_RECIPIENT=info@tirdo.or.tz
