      "default": "division"
    },
    "items": {
      "type": "text"
    },
    "headName": {
      "type": "string"
    },
    "headEmail": {
      "type": "email"
    },
    "headTitle": {
      "type": "string"
    },
    "headPhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
