{
  "kind": "collectionType",
  "collectionName": "technologies",
  "info": {
    "singularName": "technology",
    "pluralName": "technologies",
    "displayName": "Technology",
    "description": "Proven TIRDO technologies available for transfer and adoption"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "summary": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "sector": {
      "type": "enumeration",
      "enum": ["energy", "food-biotechnology", "materials", "environment", "textile-leather", "ict"],
      "default": "materials",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "maturity": {
      "type": "enumeration",
      "enum": ["Concept", "Pilot", "Commercial", "Mature"],
      "default": "Commercial",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "body": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "benefits": { "type": "json", "pluginOptions": { "i18n": { "localized": false } } },
    "applications": { "type": "json", "pluginOptions": { "i18n": { "localized": false } } },
    "relatedServiceSlug": { "type": "string", "pluginOptions": { "i18n": { "localized": false } } },
    "imageUrl": { "type": "string", "pluginOptions": { "i18n": { "localized": false } } },
    "cover": { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } }
  }
}
